# ── Anthropic ──
ANTHROPIC_API_KEY=your-anthropic-key
MODEL_HAIKU=claude-haiku-4-5
MODEL_SONNET=claude-sonnet-4-6
MODEL_OPUS=claude-sonnet-4-6

# ── Node callbacks (shared internal token must match Node's INTERNAL_TOKEN) ──
NODE_URL=http://localhost:4000
INTERNAL_TOKEN=replace-with-a-random-64-hex-string   # e.g. `openssl rand -hex 32`

# ── Tuning ──
MAX_PARALLEL_AGENTS=5
PDF_ENGINE=weasyprint        # weasyprint | chromium
# CHROMIUM_PATH=chromium     # only if PDF_ENGINE=chromium

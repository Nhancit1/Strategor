# ═══════════════════════════════════════════════════════════════════
# Strategor (MERN + Python) — root environment for docker compose
# Copy to .env and fill the REQUIRED values, then: docker compose up -d --build
# ═══════════════════════════════════════════════════════════════════

# ── REQUIRED ──
ANTHROPIC_API_KEY=sk-ant-api03-xxxxx
JWT_SECRET=                       # generate: openssl rand -hex 32
INTERNAL_TOKEN=                   # generate: openssl rand -hex 32 (shared Node<->Python)

# ── Models (override if needed) ──
MODEL_HAIKU=claude-haiku-4-5-20251001
MODEL_SONNET=claude-sonnet-4-6
MODEL_OPUS=claude-opus-4-7

# ── Mongo ──
MONGO_DB=strategor

# ── JWT lifetimes (seconds) ──
JWT_EXPIRY=900                     # access token TTL (seconds) — 15 min, client auto-refreshes
JWT_REFRESH_EXPIRY=2592000

# ── URLs / CORS (single-host default; nginx serves on :80) ──
CORS_ALLOWED_ORIGINS=http://localhost
APP_URL=http://localhost
FRONTEND_URL=http://localhost

# ── Uploads ──
UPLOAD_MAX_BYTES=26214400         # 25 MB
UPLOAD_MAX_PER_PROJECT=5

# ── Tuning ──
MAX_PARALLEL_AGENTS=5
PDF_ENGINE=weasyprint             # weasyprint | chromium

# ── Web-search grounding (agents 2,4,5,9,11 enrich with current web facts) ──
GROUNDING_ENABLED=true            # false -> brief + documents only (no web)
WEB_SEARCH_MAX_USES=5             # max searches per grounded agent
WEB_SEARCH_COST_CENTS=1           # cost per web search (Anthropic ≈ $10 / 1000)
# MODEL_RESEARCH=claude-sonnet-4-6

# ── Self-correction loop — regenerate agents flagged by the consistency check, then
#    re-validate. Bounded by rounds + agents/round to cap cost. ENABLED=false to disable. ──
SELF_CORRECTION_ENABLED=true
SELF_CORRECTION_MAX_ROUNDS=2
SELF_CORRECTION_MAX_AGENTS=6

# ── AI cost reporting (admin) — ALERT only, never blocks a run. Default $2.00 ──
COST_ALERT_THRESHOLD_CENTS=200

# ── Email / SMTP (false -> admin-set credentials are logged to console) ──
EMAIL_ENABLED=false
EMAIL_FROM=noreply@strategor.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

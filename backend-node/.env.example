# ── Server ──
PORT=4000
NODE_ENV=development
SELF_URL=http://localhost:4000

# ── MongoDB ──
MONGO_URI=mongodb://localhost:27017/strategor

# ── JWT (HS256). Generate a strong secret: openssl rand -hex 32 ──
JWT_SECRET=CHANGEME-min-32-chars-openssl-rand-hex-32-XXXXXXXX
JWT_EXPIRY=900
JWT_REFRESH_EXPIRY=2592000

# ── CORS (frontend origins, comma-separated) ──
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Python AI/export microservice ──
AI_SERVICE_URL=http://localhost:8000
INTERNAL_TOKEN=dev-internal-token-change-me

# ── AI cost reporting (admin) — ALERT only, never blocks a run. Default $2.00 ──
COST_ALERT_THRESHOLD_CENTS=200

# ── Uploads ──
UPLOAD_PATH=/tmp/strategor-uploads
UPLOAD_MAX_BYTES=26214400
UPLOAD_MAX_PER_PROJECT=5

# ── Email / SMTP (false in dev -> credentials are logged to console) ──
EMAIL_ENABLED=false
EMAIL_FROM=noreply@strategor.local
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── App URLs (used in email links) ──
APP_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
